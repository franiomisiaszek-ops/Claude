# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# The real .env is ignored by git. NEVER commit it or paste keys into chat.

# --- Claude API (required from Phase 3) --------------------------------------
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- Alpaca PAPER account (required from Phase 2) -----------------------------
# https://app.alpaca.markets -> switch to "Paper" -> API keys.
# Paper keys start with "PK". The program refuses to start with a live key ("AK").
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Telegram (required from Phase 6) -----------------------------------------
# Create a bot with @BotFather to get the token; TELEGRAM_CHAT_ID is your own chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional data sources -----------------------------------------------------
# Finnhub (earnings calendar + estimates): https://finnhub.io  (free tier)
FINNHUB_API_KEY=
# FRED (macro data): https://fred.stlouisfed.org/docs/api/api_key.html  (free)
FRED_API_KEY=

# --- SEC EDGAR (required from Phase 2) ------------------------------------------
# The SEC requires a contact string on every request, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=

# --- Wikipedia (optional) ----------------------------------------------------------
# The S&P 500 member list is read from Wikipedia, which asks automated tools to say who
# they are. If the "universe" step reports HTTP 403, put an email address or web page
# here and it will be sent to Wikipedia with each request. Left blank, nothing personal
# is sent and the program falls back to its built-in list when Wikipedia refuses.
WIKIPEDIA_CONTACT=

# --- Database --------------------------------------------------------------------
# Leave DATABASE_URL blank: Docker Compose points the app at its own PostgreSQL,
# and outside Docker a local SQLite file (data/papertrader.db) is used.
DATABASE_URL=
# Password for the PostgreSQL container. Change it before first start.
POSTGRES_PASSWORD=change-me

# --- Misc (defaults are fine) -----------------------------------------------------
PAPERTRADER_CONFIG=config.yaml
DATA_DIR=data
LOG_LEVEL=INFO
LOG_FORMAT=json
