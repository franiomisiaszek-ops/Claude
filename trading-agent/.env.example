# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# The real .env is ignored by git. NEVER commit it or paste keys into chat.

# --- Claude API (required from Phase 3) --------------------------------------
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- Alpaca PAPER account (required from Phase 2) -----------------------------
# https://app.alpaca.markets -> switch to "Paper" -> API keys.
# Paper keys start with "PK". The program refuses to start with a live key ("AK").
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- The three-way experiment -------------------------------------------------------
# Which system a process runs (A, B or C). Docker Compose sets it for each service.
SYSTEM=A
# Paper accounts of systems B and C (keys start with PK, like A's above).
ALPACA_B_API_KEY=
ALPACA_B_SECRET_KEY=
ALPACA_C_API_KEY=
ALPACA_C_SECRET_KEY=

# --- Telegram (required from Phase 6) -----------------------------------------
# Create a bot with @BotFather to get the token. Then press Start in your bot and run
# `papertrader telegram setup` to get TELEGRAM_CHAT_ID (README, section Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional data sources -----------------------------------------------------
# Finnhub (earnings calendar + estimates): https://finnhub.io  (free tier)
FINNHUB_API_KEY=
# FRED (macro data): https://fred.stlouisfed.org/docs/api/api_key.html  (free)
FRED_API_KEY=
# System B only, both PAID and both optional (switches 8 and 9 in config/b.yaml).
# Leave empty until you decide to subscribe; nothing is fetched without a key.
# MarketData.app (options data, about $12/month): https://www.marketdata.app
MARKETDATA_API_KEY=
# Financial Modeling Prep (analyst estimates and grades, about $49/month): https://site.financialmodelingprep.com
FMP_API_KEY=

# --- SEC EDGAR (required from Phase 2) ------------------------------------------
# The SEC requires a contact string on every request, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=

# --- Wikipedia (optional) ----------------------------------------------------------
# The S&P 500 member list is read from Wikipedia, which asks automated tools to say who
# they are. If the "universe" step reports HTTP 403, put an email address or web page
# here and it will be sent to Wikipedia with each request. Left blank, nothing personal
# is sent and the program falls back to its built-in list when Wikipedia refuses.
WIKIPEDIA_CONTACT=

# --- Database --------------------------------------------------------------------
# Leave DATABASE_URL blank: Docker Compose points the app at its own PostgreSQL,
# and outside Docker a local SQLite file (data/papertrader.db) is used.
DATABASE_URL=
# Password for the PostgreSQL container. Change it before first start.
POSTGRES_PASSWORD=change-me

# --- Backups (optional) -------------------------------------------------------------
# Where the nightly backups go. Default: the "backups" folder here. A OneDrive folder
# gives you a copy in the cloud, e.g. C:/Users/your-name/OneDrive/papertrader-backups
BACKUP_DIR=
# How many nightly backups to keep (default 7).
BACKUP_KEEP=

# --- Misc (defaults are fine) -----------------------------------------------------
PAPERTRADER_CONFIG=config.yaml
DATA_DIR=data
REPORTS_DIR=reports
# Set by Docker Compose (the backups folder as the app sees it). Leave blank.
BACKUPS_DIR=
LOG_LEVEL=INFO
LOG_FORMAT=json
