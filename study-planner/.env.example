# Copy to .env for local development (all optional locally; required ones are marked for production).

# Production: the public https address of the site, e.g. https://cramless.onrender.com
PUBLIC_URL=
# Production: Postgres connection string. Locally, leave empty to use the built-in database in ./data
DATABASE_URL=
# Production: long random strings (Render generates these from render.yaml)
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Optional: Claude AI document and syllabus analysis
ANTHROPIC_API_KEY=
# Default model is claude-opus-5-5. A cheaper model is your choice, e.g. claude-haiku-5-5 (~40x cheaper, less capable).
ANTHROPIC_MODEL=
AI_DAILY_LIMIT=10
AI_MONTHLY_BUDGET_USD=4

# Optional: Google sign-in + Classroom/Calendar (one OAuth client for the whole app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email (account confirmation, password reset, daily email). Needs a verified domain at resend.com
RESEND_API_KEY=
EMAIL_FROM=Cramless <hello@your-domain.com>
SUPPORT_EMAIL=

# Optional: push keys. If empty, the server generates a pair once and stores it (encrypted) in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
