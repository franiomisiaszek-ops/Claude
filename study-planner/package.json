{
  "name": "study-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto-generated study plans from Google Classroom, Calendar, LMS feeds and manual material, with daily reminders.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-ical": "^0.20.1",
    "web-push": "^3.6.7",
    "chrono-node": "^2.7.7",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
