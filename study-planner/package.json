{
  "name": "study-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto-generated study plans from Google Classroom, Calendar, LMS feeds and manual material, with daily reminders.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@electric-sql/pglite": "^0.5.15",
    "better-auth": "^1.7.16",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.0",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
